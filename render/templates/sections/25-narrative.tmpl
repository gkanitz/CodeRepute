{{define "25-narrative.tmpl"}}
{{$n := narrative $}}
{{if or $n.ProfileSentence $n.TrajectorySentence $n.Probes}}
<section class="report-section narrative">
  <h2>Narrative</h2>
  <p class="section-intro">
    A summary of the collaboration profile and questions for a follow-up conversation. This is not a quality score or a ranking.
  </p>

  {{if $n.ProfileSentence}}
  <div class="interpretation">
    <p>{{$n.ProfileSentence}}</p>
  </div>
  {{end}}

  {{if $n.TrajectorySentence}}
  <div class="interpretation">
    <p>{{$n.TrajectorySentence}}</p>
  </div>
  {{end}}

  {{if $n.Probes}}
  <div class="metric-story">
    <h3>Interviewer kit</h3>
    <p class="muted">Three questions to explore in a follow-up conversation, grounded in the data.</p>
    <ol style="margin:0;padding-left:1.25rem">
      {{range $n.Probes}}
      <li style="margin-bottom:.75rem;font-size:.88rem">{{.Question}}</li>
      {{end}}
    </ol>
  </div>
  {{end}}
</section>

{{/* Derivation annex — lists every rule that fired */}}
{{$entries := narrativeAnnex $}}
{{if $entries}}
<hr class="annex-rule">
<h2 class="annex-title">How this narrative was derived</h2>
<section class="annex-section">
  <p>Each narrative sentence and probe question is produced by a deterministic rule operating on the attested report data. The table below lists every rule that contributed to this section.</p>
  <table class="annex-table">
    <tr><th>Rule ID</th><th>Explanation</th></tr>
    {{range $entries}}
    <tr><td><code>{{.RuleID}}</code></td><td>{{.Explanation}}</td></tr>
    {{end}}
  </table>
</section>
{{end}}
{{end}}
{{end}}