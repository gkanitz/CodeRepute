{{define "60-transparency.tmpl"}}
{{with .AccessManifest}}
<hr class="annex-rule">
<h2 class="annex-title">What this tool read</h2>

<section class="annex-section">
  <p>
    This report was built exclusively from API metadata. The platform's API
    was called for the following data types (each with the number of requests
    made during the run):
  </p>

  <table class="annex-table">
    <tr><th>Data type</th><th>Requests</th></tr>
    {{range .Endpoints}}
    <tr><td>{{classLabel .Class}}</td><td>{{.Count}}</td></tr>
    {{end}}
  </table>

  {{if .Notes}}
  <p class="muted">{{.Notes}}</p>
  {{end}}

  {{if .NeverRequested}}
  <h3>Data never requested</h3>
  <p>The following data types are <strong>explicitly never requested</strong> by this tool:</p>
  <ul>
    {{range .NeverRequested}}
    <li>{{.}}</li>
    {{end}}
  </ul>
  <p class="muted">This is a static, reviewed declaration. Any violation would be caught by the route-class enforcement test and would be visible in the endpoint list above.</p>
  {{end}}
</section>

<section class="annex-section">
  <h3>What this report does not include and why</h3>
  {{if .NoScoreDeclaration}}
  <p><strong>No score or ranking:</strong> {{.NoScoreDeclaration}}</p>
  {{end}}
  {{if .Omissions}}
  {{range .Omissions}}
  <p><strong>{{upperFirst .Category}}:</strong> {{.Description}} <a href="{{.PrivacyRationaleRef}}">Privacy rationale</a></p>
  {{end}}
  {{else}}
  <p>None declared.</p>
  {{end}}
</section>

  {{with $.Verification}}
  {{if or .WorkflowRef .Repository .RunURL}}
  <section class="annex-section">
    <h3>Provenance</h3>
    <p><strong>Produced by workflow:</strong> <code>{{or .WorkflowRef "[not available]"}}</code></p>
    <p><strong>Repository:</strong> <code>{{or .Repository "[not available]"}}</code></p>
    <p><strong>Run:</strong> {{if .RunURL}}<a href="{{.RunURL}}">{{.RunURL}}</a>{{else}}<code>[not available]</code>{{end}}</p>
    <p>Reports are signed via keyless Sigstore and recorded in the public Sigstore Rekor transparency log.</p>
    <pre>gh attestation verify &lt;file&gt; --repo {{or .Repository "[not available]"}} --signer-workflow {{or .WorkflowRef "[not available]"}}</pre>
  </section>
  {{end}}
  {{end}}
{{end}}
{{end}}